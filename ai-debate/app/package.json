{
  "name": "ai-debate-app",
  "version": "1.0.0",
  "private": true,
  "description": "Giao diện web + LLM gateway cho hệ thống AI Debate (n8n điều phối)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "mock": "node mock/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "build:workflow": "node ../n8n/src/build-workflow.mjs",
    "check:workflow": "node ../n8n/src/build-workflow.mjs --check"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "marked": "18.1.3",
    "pg": "8.23.1",
    "puppeteer-core": "25.16.0",
    "sanitize-html": "2.18.1"
  }
}
