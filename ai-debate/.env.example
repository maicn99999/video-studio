# =====================================================================
#  AI DEBATE — FILE CẤU HÌNH MẪU
#  1) Sao chép:  cp .env.example .env     (hoặc chạy ./scripts/setup.sh để tự sinh secret)
#  2) Điền các giá trị bên dưới. TUYỆT ĐỐI không commit file .env lên GitHub.
#  3) Áp dụng thay đổi:  docker compose up -d
# =====================================================================

# ---------- Tên miền & HTTPS ----------
# Tên miền trỏ (bản ghi A) về IP của VPS. Caddy tự cấp chứng chỉ HTTPS miễn phí.
APP_DOMAIN=debate.example.com
TZ=Asia/Ho_Chi_Minh

# ---------- Đăng nhập giao diện web ----------
# Mật khẩu bạn dùng để đăng nhập trang AI Debate (tối thiểu 10 ký tự, nên dài & ngẫu nhiên).
# Nếu mật khẩu có ký tự $ hãy đặt trong nháy đơn, vd: APP_PASSWORD='abc$123xyz'
APP_PASSWORD=
# Chuỗi bí mật ký cookie (≥ 32 ký tự). Sinh bằng: openssl rand -hex 32
SESSION_SECRET=

# ---------- API key của 3 nhà cung cấp AI ----------
# OpenAI (GPT-6 Sol):        https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (Claude Opus 5.5): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Meta Model API (Muse Wonder): https://dev.meta.ai -> API keys (tài liệu Meta gọi là MODEL_API_KEY)
META_API_KEY=
# Tùy chọn: thay vì ghi key ở đây, có thể trỏ tới file secret (Docker secrets / secret manager), vd:
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key   (xem README mục "Lưu API key an toàn")

# ---------- Model (giữ mặc định theo yêu cầu) ----------
OPENAI_MODEL=gpt-6-sol
ANTHROPIC_MODEL=claude-opus-5-5
META_MODEL=muse-wonder-1.0
# Mức suy luận: OpenAI none|low|medium|high|xhigh|max ; Claude low|medium|high|xhigh|max
OPENAI_REASONING_EFFORT=high
ANTHROPIC_EFFORT=high
META_REASONING_EFFORT=high
# Meta: "responses" (mặc định, /v1/responses) hoặc "chat" (/v1/chat/completions)
META_API_STYLE=responses
# Claude: tự chuyển sang model dự phòng của Anthropic khi bộ lọc an toàn từ chối (true/false)
ANTHROPIC_REFUSAL_FALLBACK=true

# ---------- Giới hạn chi phí (USD) — 0 = không giới hạn ----------
MAX_COST_PER_SESSION_USD=3
MAX_COST_PER_DAY_USD=15
MAX_COST_PER_MONTH_USD=100
# Số phiên được chạy cùng lúc
MAX_CONCURRENT_DEBATES=2
# Số token đầu ra tối đa mỗi lượt (bao gồm token suy luận)
DEBATE_MAX_OUTPUT_TOKENS=16000
JUDGE_MAX_OUTPUT_TOKENS=20000
# Ghi đè bảng giá (USD / 1 triệu token) khi nhà cung cấp đổi giá, ví dụ:
# PRICE_OVERRIDES_JSON={"gpt-6-sol":{"input":2,"cachedInput":0.2,"output":10}}
PRICE_OVERRIDES_JSON=

# ---------- Retry / timeout ----------
# Tối đa cho 1 lần gọi API (ms) — 10 phút
LLM_TIMEOUT_MS=600000
# Tổng thời gian 1 lượt kể cả retry (ms) — 20 phút
LLM_CALL_DEADLINE_MS=1200000
# Số lần thử lại khi gặp 429 / 5xx / 529 / timeout (có backoff + tôn trọng retry-after)
LLM_MAX_RETRIES=4
LLM_MAX_CONCURRENCY_PER_PROVIDER=4
# Phiên không tiến triển quá N phút -> tự đánh dấu lỗi
SESSION_TIMEOUT_MIN=60

# ---------- Secret nội bộ (sinh ngẫu nhiên, không cần nhớ) ----------
# Sinh bằng: openssl rand -hex 32
DEBATE_INTERNAL_TOKEN=
N8N_ENCRYPTION_KEY=
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
APP_DB_USER=debate
APP_DB_NAME=debate
APP_DB_PASSWORD=

# ---------- Nâng cao ----------
N8N_VERSION=2.46.6
# true: mỗi lần khởi động n8n sẽ import lại workflow từ thư mục n8n/workflows (khuyến nghị)
N8N_AUTO_IMPORT=true
N8N_CONCURRENCY_PRODUCTION_LIMIT=4
# true: cài Chromium để xuất PDF phía máy chủ
WITH_PDF=true
LLM_MODE=live
COOKIE_SECURE=true
